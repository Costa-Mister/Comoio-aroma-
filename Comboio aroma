    </div>
  </div>

  <!-- BOTÃO LATERAL FIXO -->
  <button id="btn-terminal-toggle" onclick="toggleTerminal()">&lt;/&gt; CÓDIGO</button>

  <!-- TERMINAL OVERLAY -->
  <div id="terminal-overlay">
    <div class="terminal-window">
      <div class="terminal-header">
        <span>fastfetch@comboio-aroma:~ $ cat codigo_fonte.html</span>
        <button class="terminal-close-btn" onclick="toggleTerminal()">X</button>
      </div>
      <div class="terminal-body" id="terminal-content">
        <!-- Código injetado via JS -->
      </div>
    </div>
  </div>

  <script>
    // TERMINAL INTERATIVO
    function toggleTerminal() {
      const terminal = document.getElementById('terminal-overlay');
      const terminalContent = document.getElementById('terminal-content');
      
      if (terminal.style.display === 'flex') {
        terminal.style.display = 'none';
      } else {
        terminal.style.display = 'flex';
        terminalContent.textContent = document.documentElement.outerHTML;
      }
    }

    const dadosEstacoes = {
      1: {
        nome: '1. Almoxarifado',
        resp: 'Gabriel',
        desc: 'Gabriel ao lado da mesa de trabalho, organizando a caixa com garrafas PET transparentes cruas recebidas para produção.'
      },
      2: {
        nome: '2. Desrotulagem & Preparação',
        resp: 'Vitor',
        desc: 'Vitor ao lado da mesa com as garrafas PET limpas e sem rótulo sobre a bancada, preparadas para o envase.'
      },
      3: {
        nome: '3. Envase do Aroma',
        resp: 'Gabriel',
        desc: 'Gabriel operando o envase das garrafas PET com o líquido aromático lavanda sobre a mesa de trabalho.'
      },
      4: {
        nome: '4. Aplicação do Novo Rótulo',
        resp: 'Vitor',
        desc: 'Vitor aplicando a rotulagem final sobre as garrafas já envasadas posicionadas na mesa.'
      },
      5: {
        nome: '5. Kit Palitinhos',
        resp: 'Gabriel',
        desc: 'Gabriel realizando a montagem do kit com os palitinhos difusores fixados na lateral da garrafa rotulada.'
      },
      6: {
        nome: '6. Expedição Final',
        resp: 'Vitor',
        desc: 'Vitor organizando a estante de expedição final com os lotes de aromatizadores concluídos.'
      }
    };

    let scene, camera, renderer, controls, currentGroup;

    function init3D() {
      const container = document.getElementById('canvas-container');
      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x1A2F3D);

      camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
      camera.position.set(3.5, 3.5, 4.5);

      renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setSize(container.clientWidth, container.clientHeight);
      container.appendChild(renderer.domElement);

      // CONTROLES DE MOUSE (OrbitControls)
      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.maxPolarAngle = Math.PI / 2;
      controls.minDistance = 2;
      controls.maxDistance = 10;

      // Luzes
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.9);
      scene.add(ambientLight);

      const dirLight = new THREE.DirectionalLight(0xffffff, 0.6);
      dirLight.position.set(5, 8, 5);
      scene.add(dirLight);

      // Chão com grade estilizada em Y = -0.8
      const gridHelper = new THREE.GridHelper(6, 12, 0xF3C258, 0x2C9692);
      gridHelper.position.y = -0.8;
      scene.add(gridHelper);

      // Carregar estação inicial
      criarCenaEstacao(1);

      function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
      }
      animate();
    }

    // CONSTRUTOR DO PORQUINHO 3D (Base perfeitamente em Y = 0 dentro do grupo)
    function criarPorquinho() {
      const pigGroup = new THREE.Group();
      const matPig = new THREE.MeshLambertMaterial({ color: 0xffb6c1 });
      const matEar = new THREE.MeshLambertMaterial({ color: 0xff99aa });
      const matSnout = new THREE.MeshLambertMaterial({ color: 0xf48fb1 });
      const matEye = new THREE.MeshLambertMaterial({ color: 0x1A2F3D });

      // Corpo apoiado sobre a base Y=0 (raio = 0.5)
      const corpo = new THREE.Mesh(new THREE.SphereGeometry(0.5, 16, 16), matPig);
      corpo.position.y = 0.5;
      pigGroup.add(corpo);

      const cabeca = new THREE.Mesh(new THREE.SphereGeometry(0.38, 16, 16), matPig);
      cabeca.position.set(0, 0.95, 0.15);
      pigGroup.add(cabeca);

      const focinho = new THREE.Mesh(new THREE.CylinderGeometry(0.14, 0.14, 0.12, 12), matSnout);
      focinho.rotation.x = Math.PI / 2;
      focinho.position.set(0, 0.93, 0.5);
      pigGroup.add(focinho);

      const olhoE = new THREE.Mesh(new THREE.SphereGeometry(0.04, 8, 8), matEye);
      olhoE.position.set(-0.14, 1.02, 0.46);
      const olhoD = olhoE.clone();
      olhoD.position.set(0.14, 1.02, 0.46);
      pigGroup.add(olhoE, olhoD);

      const orelhaE = new THREE.Mesh(new THREE.ConeGeometry(0.09, 0.2, 8), matEar);
      orelhaE.position.set(-0.22, 1.25, 0.22);
      orelhaE.rotation.z = -0.3;
      const orelhaD = orelhaE.clone();
      orelhaD.position.set(0.22, 1.25, 0.22);
      orelhaD.rotation.z = 0.3;
      pigGroup.add(orelhaE, orelhaD);

      const bracoE = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 0.3, 8), matPig);
      bracoE.position.set(-0.32, 0.6, 0.3);
      bracoE.rotation.x = -Math.PI / 3;
      bracoE.rotation.z = -0.2;

      const bracoD = bracoE.clone();
      bracoD.position.set(0.32, 0.6, 0.3);
      bracoD.rotation.z = 0.2;

      pigGroup.add(bracoE, bracoD);

      return pigGroup;
    }

    // CONSTRUTOR DE MESA DE TRABALHO (Pés exatamente sobre Y = -0.8)
    function criarMesa() {
      const mesaGroup = new THREE.Group();
      const matMesa = new THREE.MeshLambertMaterial({ color: 0x8d6e63 });
      const matPernas = new THREE.MeshLambertMaterial({ color: 0x5d4037 });

      // Pernas: altura = 0.75, centro Y = -0.425 -> base Y = -0.8 (encosta exato no chão amarelado)
      const pernaGeo = new THREE.BoxGeometry(0.1, 0.75, 0.1);
      const posPernas = [
        [-0.7, -0.425, -0.4],
        [0.7, -0.425, -0.4],
        [-0.7, -0.425, 0.4],
        [0.7, -0.425, 0.4]
      ];

      posPernas.forEach(p => {
        const perna = new THREE.Mesh(pernaGeo, matPernas);
        perna.position.set(p[0], p[1], p[2]);
        mesaGroup.add(perna);
      });

      // Tampo da mesa (espessura 0.1, centro Y = -0.05 -> superfície topo Y = 0.0)
      const tampo = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.1, 1.0), matMesa);
      tampo.position.y = -0.05;
      mesaGroup.add(tampo);

      return mesaGroup;
    }

    // CONSTRUTOR DE GARRAFA PET 3D
    function criarGarrafaPET(comLiquido = false, corLiquido = 0x9c27b0, comRotulo = false, comPalitos = false) {
      const gGroup = new THREE.Group();
      
      const matPET = new THREE.MeshPhongMaterial({ color: 0xffffff, transparent: true, opacity: 0.55 });
      const corpoPET = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.22, 0.7, 12), matPET);
      corpoPET.position.y = 0.35; // Base da garrafa em Y = 0
      gGroup.add(corpoPET);

      const matTampa = new THREE.MeshLambertMaterial({ color: 0x1A2F3D });
      const tampa = new THREE.Mesh(new THREE.CylinderGeometry(0.08, 0.08, 0.1, 10), matTampa);
      tampa.position.y = 0.75;
      gGroup.add(tampa);

      if (comLiquido) {
        const matLiq = new THREE.MeshLambertMaterial({ color: corLiquido });
        const liq = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.45, 12), matLiq);
        liq.position.y = 0.25;
        gGroup.add(liq);
      }

      if (comRotulo) {
        const matRotulo = new THREE.MeshLambertMaterial({ color: 0xD95338 });
        const rotulo = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.23, 0.3, 12), matRotulo);
        rotulo.position.y = 0.37;
        gGroup.add(rotulo);
      }

      if (comPalitos) {
        const matPalito = new THREE.MeshLambertMaterial({ color: 0xF3C258 });
        for(let i = -0.08; i <= 0.08; i += 0.08) {
          const palito = new THREE.Mesh(new THREE.CylinderGeometry(0.012, 0.012, 0.9, 6), matPalito);
          palito.position.set(0.25, 0.45, i);
          gGroup.add(palito);
        }
      }

      return gGroup;
    }

    // MONTAGEM DAS CENAS
    function criarCenaEstacao(id) {
      if (currentGroup) scene.remove(currentGroup);

      currentGroup = new THREE.Group();
      
      // PORQUINHO TOCA EXATAMENTE A LINHA AMARELA (Y = -0.8) E AFASTADO DA MESA (X = -1.4)
      const porquinho = criarPorquinho();
      porquinho.position.set(-1.4, -0.8, 0);
      currentGroup.add(porquinho);

      if (id >= 1 && id <= 5) {
        const mesa = criarMesa();
        currentGroup.add(mesa);

        // Tampo superior da mesa fica em Y = 0.0
        const Y_MESA = 0.0;

        if (id === 1) {
          const matCaixa = new THREE.MeshLambertMaterial({ color: 0xa1887f });
          const caixa = new THREE.Mesh(new THREE.BoxGeometry(1.0, 0.35, 0.7), matCaixa);
          caixa.position.set(0.2, Y_MESA + 0.175, 0);
          currentGroup.add(caixa);

          for (let x = -0.1; x <= 0.5; x += 0.3) {
            const g = criarGarrafaPET(false);
            g.scale.set(0.5, 0.5, 0.5);
            g.position.set(x, Y_MESA + 0.35, 0);
            currentGroup.add(g);
          }
        } else if (id === 2) {
          for (let x = -0.3; x <= 0.5; x += 0.4) {
            const g = criarGarrafaPET(false);
            g.scale.set(0.65, 0.65, 0.65);
            g.position.set(x, Y_MESA, 0);
            currentGroup.add(g);
          }
        } else if (id === 3) {
          for (let x = -0.3; x <= 0.5; x += 0.4) {
            const g = criarGarrafaPET(true, 0x9c27b0, false, false);
            g.scale.set(0.65, 0.65, 0.65);
            g.position.set(x, Y_MESA, 0);
            currentGroup.add(g);
          }
        } else if (id === 4) {
          for (let x = -0.3; x <= 0.5; x += 0.4) {
            const g = criarGarrafaPET(true, 0x9c27b0, true, false);
            g.scale.set(0.65, 0.65, 0.65);
            g.position.set(x, Y_MESA, 0);
            currentGroup.add(g);
          }
        } else if (id === 5) {
          for (let x = -0.2; x <= 0.4; x += 0.6) {
            const g = criarGarrafaPET(true, 0x9c27b0, true, true);
            g.scale.set(0.65, 0.65, 0.65);
            g.position.set(x, Y_MESA, 0);
            currentGroup.add(g);
          }
        }
      } else if (id === 6) {
        // Estação de Expedição (Estante encostando em Y = -0.8)
        const matPrateleira = new THREE.MeshLambertMaterial({ color: 0x5d4037 });
        const prateleiraGroup = new THREE.Group();

        const base = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.1, 0.8), matPrateleira);
        base.position.y = 0.05;
        const meio = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.1, 0.8), matPrateleira);
        meio.position.y = 0.75;
        const topo = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.1, 0.8), matPrateleira);
        topo.position.y = 1.45;

        prateleiraGroup.add(base, meio, topo);

        const alturas = [0.1, 0.8, 1.5];
        alturas.forEach(h => {
          for(let x = -0.5; x <= 0.5; x += 0.5) {
            const g = criarGarrafaPET(true, 0x9c27b0, true, true);
            g.scale.set(0.65, 0.65, 0.65);
            g.position.set(x, h, 0);
            prateleiraGroup.add(g);
          }
        });

        prateleiraGroup.position.set(0.5, -0.8, 0.2);
        currentGroup.add(prateleiraGroup);
      }

      scene.add(currentGroup);
      if(controls) controls.reset();
    }

    function carregarEstacao(id) {
      const info = dadosEstacoes[id];
      
      document.getElementById('estacao-nome').innerText = info.nome;
      document.getElementById('estacao-resp').innerText = info.resp;
      document.getElementById('estacao-desc').innerText = info.desc;

      criarCenaEstacao(id);

      const botoes = document.querySelectorAll('.btn-estacao');
      botoes.forEach((btn, index) => {
        if(index + 1 === id) btn.classList.add('active');
        else btn.classList.remove('active');
      });
    }

    function entrarPlataforma() {
      const splash = document.getElementById('splash-screen');
      const main = document.getElementById('main-content');
      
      splash.style.opacity = '0';
      setTimeout(() => {
        splash.style.display = 'none';
        main.style.display = 'block';
        init3D();
      }, 300);
    }
  </script>
