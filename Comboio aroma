      </div>

      <button class="btn-brown" onclick="entrarPlataforma()">[ ENTRAR NA MAQUETE ]</button>
    </div>
  </div>

  <!-- CONTEÚDO PRINCIPAL -->
  <div id="main-content">
    <header>
      <div class="header-title-container">
        <div>
          <h1>Comboio do Aroma</h1>
          <small style="color: var(--retro-teal); font-weight: bold;">Atividade de Gestão de Produção — Profª Raquel Canela</small>
        </div>
      </div>

      <div class="equipe-badge">
        👥 Gabriel | Vitor
      </div>
    </header>

    <!-- PAINEL FASTFETCH / DETALHES DE SISTEMA -->
    <div class="fastfetch-banner">
      <div class="fastfetch-ascii">
   ___ 
  / __|  COMBOIO DO AROMA v2.0
 | (__   ---------------------
  \___|  MAQUETE VIRTUAL 3D
      </div>
      <div class="fastfetch-info">
        <div class="user-host">producao@comboio-do-aroma-os</div>
        <div><span class="key">Alunos:</span> <span class="val">Gabriel, Vitor</span></div>
        <div><span class="key">Matéria:</span> <span class="val">Gestão de Produção</span></div>
        <div><span class="key">Professora:</span> <span class="val">Raquel Canela</span></div>
        <div><span class="key">Layout:</span> <span class="val">Celular</span></div>
        <div class="color-blocks">
          <div class="color-block" style="background: var(--retro-red);"></div>
          <div class="color-block" style="background: var(--retro-orange);"></div>
          <div class="color-block" style="background: var(--retro-yellow);"></div>
          <div class="color-block" style="background: var(--retro-teal);"></div>
          <div class="color-block" style="background: var(--retro-dark-blue);"></div>
        </div>
      </div>
    </div>

    <div class="panel-container">
      
      <!-- PAINEL DA LINHA DE MONTAGEM -->
      <div class="panel">
        <h2>
          <span>🏭 Estações de Trabalho</span>
          <span class="panel-tag">ESTAÇÕES</span>
        </h2>
        <p><small style="color: var(--retro-teal);">Clique nas abas para alterar a etapa:</small></p>

        <div class="grid-estacoes">
          <button class="btn-estacao active" onclick="carregarEstacao(1)">
            <span class="num">E-01</span> Almoxarifado
