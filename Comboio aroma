          <button class="btn-estacao" onclick="carregarEstacao(3)">
            <span class="num">E-03</span> Envase do Aroma
            <span class="responsavel">Resp: Gabriel</span>
          </button>

          <button class="btn-estacao" onclick="carregarEstacao(4)">
            <span class="num">E-04</span> Novo Rótulo
            <span class="responsavel">Resp: Vitor</span>
          </button>

          <button class="btn-estacao" onclick="carregarEstacao(5)">
            <span class="num">E-05</span> Kit Palitinhos
            <span class="responsavel">Resp: Gabriel</span>
          </button>

          <button class="btn-estacao" onclick="carregarEstacao(6)">
            <span class="num">E-06</span> Expedição
            <span class="responsavel">Resp: Vitor</span>
          </button>
        </div>
      </div>

      <!-- PAINEL DE MAQUETE 3D E INFORMAÇÕES -->
      <div class="panel">
        <h2>
          <span>🧊 Maquete 3D Interativa</span>
          <span class="panel-tag">THREE.JS</span>
        </h2>
        
        <!-- CANVAS THREE.JS -->
        <div id="canvas-container">
          <div class="controls-hint">🖱️ Arraste para girar | Scroll para zoom</div>
        </div>

        <div class="detail-card">
          <h3 id="estacao-nome" style="margin-top:0; color:var(--retro-red); font-family: 'VT323', monospace; font-size: 1.6rem;">1. Almoxarifado</h3>
          <p><strong>Operador Responsável:</strong> <span id="estacao-resp">Gabriel</span></p>
          <p id="estacao-desc" style="font-size: 0.88rem; line-height: 1.5; margin-bottom: 0;">
            Gabriel organizando a caixa com garrafas PET transparentes recebidas para produção.
